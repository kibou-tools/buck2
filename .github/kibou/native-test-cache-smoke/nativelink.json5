{
  stores: [
    {
      name: "AC_STORE",
      filesystem: {
        content_path: "/data/ac/content",
        temp_path: "/data/ac/temp",
        eviction_policy: { max_bytes: 1000000000 },
      },
    },
    {
      name: "CAS_STORE",
      filesystem: {
        content_path: "/data/cas/content",
        temp_path: "/data/cas/temp",
        eviction_policy: { max_bytes: 4000000000 },
      },
    },
  ],
  servers: [
    {
      name: "cache",
      listener: {
        http: { socket_address: "0.0.0.0:50051" },
      },
      services: {
        cas: [
          { instance_name: "main", cas_store: "CAS_STORE" },
        ],
        ac: [
          { instance_name: "main", ac_store: "AC_STORE" },
        ],
        bytestream: [
          { instance_name: "main", cas_store: "CAS_STORE" },
        ],
      },
    },
  ],
}
