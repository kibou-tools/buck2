[buildfile]
name = TARGETS

[repositories]
root = .
nano_prelude = nano_prelude

[cell_aliases]
prelude = nano_prelude

[external_cells]
nano_prelude = bundled

[buck2]
digest_algorithms = SHA256

[buck2_re_client]
action_cache_address = grpc://127.0.0.1:50051
engine_address = grpc://127.0.0.1:50051
cas_address = grpc://127.0.0.1:50051
capabilities = false
tls = false
instance_name = main

[build]
execution_platforms = root//platforms:platforms
